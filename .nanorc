include "/usr/share/nano/*.nanorc"

# makes backspace or delete erase the selection
set zap

set tabsize 4
set tabstospaces

# makes Ctrl+Right and Ctrl+Delete stop at word ends instead of beginnings
set afterends

# Cut from cursor instead of the whole line
set cutfromcursor

# alt+; = comment
bind M-; comment main

# ctrl+z = suspend aka minimize
bind ^Z suspend main

# ctrl+c = copy
bind ^C copy main

# ctrl+i = paste
bind ^I paste main

# ctrl+backspace = delete word backward
bind ^H chopwordleft main
